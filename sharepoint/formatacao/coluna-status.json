{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "txtContent": "@currentField",
  "style": {
    "padding": "2px 10px",
    "border-radius": "12px",
    "color": "white",
    "font-weight": "600",
    "text-align": "center",
    "white-space": "nowrap",
    "background-color": "=if(@currentField=='Concluído','#107c10',if(@currentField=='Em andamento','#0078d4',if(@currentField=='Pausado','#c19c00',if(@currentField=='Cancelado','#7a7574','#a19f9d'))))"
  }
}
